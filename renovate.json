{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "rangeStrategy": "replace",
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "commitMessagePrefix": "build:",
        "commitMessageAction": "In-range update of npm dependencies",
        "schedule": [
            "* 0-8 * * 1"
        ]
    },
    "packageRules": [
        {
            "matchDatasources": [
                "npm"
            ],
            "minimumReleaseAge": "3 days"
        },
        {
            "matchPackageNames": [
                "@ui5/mcp-server"
            ],
            "minimumReleaseAge": null,
            "commitMessagePrefix": "deps:"
        },
        {
            "matchDepNames": [
                "*"
            ],
            "automerge": true,
            "commitMessagePrefix": "build(deps-dev):",
            "commitMessageAction": "Bump",
            "schedule": [
                "* 8-16 * * 1"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "automerge": true,
            "commitMessagePrefix": "ci(github-actions):",
            "commitMessageAction": "Bump",
            "schedule": [
                "* 8-16 * * 1"
            ]
        },
        {
            "matchPackageNames": [
                "node",
                "npm"
            ],
            "enabled": false
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "plugins/ui5/\\.mcp\\.json"
            ],
            "matchStrings": [
                "@ui5/mcp-server@(?<currentValue>[^\"]+)"
            ],
            "depNameTemplate": "@ui5/mcp-server",
            "datasourceTemplate": "npm"
        }
    ]
}
